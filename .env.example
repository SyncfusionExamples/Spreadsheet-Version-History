# ============================================================================
# Environment Variables Template - Local Development
# ============================================================================
# 
# Instructions:
# 1. Copy this file to .env
# 2. Update values as needed for your environment
# 3. Never commit .env to git (it's already in .gitignore)
# 4. docker-compose automatically loads these variables
#
# For production, use Azure App Service settings instead:
# az webapp config appsettings set --name <app> --resource-group <rg> --settings KEY=VALUE
#
# ============================================================================

# ---- Redis Configuration ----
# For local development using docker-compose, use service name 'redis'
# For Azure, use the Redis Cache hostname
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ---- Syncfusion License ----
# Required for the application to function
# Get from: https://www.syncfusion.com
# Community License: https://www.syncfusion.com/products/communitylicense
# Commercial: Contact sales@syncfusion.com
SYNCFUSION_LICENSE_KEY=YOUR_LICENSE_KEY_HERE

# ---- Frontend Configuration ----
# Base path for static assets (for sub-path deployments)
# Example: /spreadsheet/ for deployment at /spreadsheet
# Empty string = serve at root /
VITE_APP_BASE_PATH=

# Backend URL that the frontend will use to connect to API
# Should be the public URL of your app service
# For local development: http://localhost:5000/
# For production: https://your-app.azurewebsites.net/
BACKEND_URL=http://localhost:5000/

# ---- Python Runtime ----
# Ensures Python output is immediately visible in Docker logs
PYTHONUNBUFFERED=1

# ---- Optional: Sub-path Routing ----
# If deployed behind a load balancer with path mapping
# Example: /api for deployment at /api/...
BASE_PATH=

# ---- Optional: Gunicorn Tuning ----
# Number of worker processes (default 1 for dev, 4+ for production)
GUNICORN_WORKERS=1

# Number of threads per worker (default 4)
GUNICORN_THREADS=4

# ============================================================================
# Notes:
# ============================================================================
#
# LOCAL DEVELOPMENT (docker-compose up):
#   - Use REDIS_HOST=redis (service name in docker-compose.yml)
#   - REDIS_PASSWORD should be empty for local Redis
#   - BACKEND_URL=http://localhost:5000/
#
# PRODUCTION (Azure App Service):
#   - Use REDIS_HOST=<name>.redis.cache.windows.net
#   - REDIS_PASSWORD=<your Redis primary key>
#   - REDIS_SSL=true
#   - BACKEND_URL=https://<your app>.azurewebsites.net/
#
# To deploy to Azure with these settings:
#   ./scripts/azure-deploy.sh prod "$SYNCFUSION_LICENSE_KEY" myapp
#
# ============================================================================
